minimap2 -ax map-ont Gubbins/w303.fa fwdQry_seqs_a.txt > fwd_seqs.sam
minimap2 -ax map-ont Gubbins/w303.fa revQry_seqs_a.txt > rev_seqs.sam

samtools view -@8 -bS fwd_seqs.sam | samtools sort - > fwd_seqs_sorted.bam
samtools view -@8 -bS rev_seqs.sam | samtools sort - > rev_seqs_sorted.bam

bamtobed -i fwd_seqs_sorted.bam |awk '$5 > 30' > fwd_seqs_sorted.bed
bamtobed -i rev_seqs_sorted.bam |awk '$5 > 30' > rev_seqs_sorted.bed



