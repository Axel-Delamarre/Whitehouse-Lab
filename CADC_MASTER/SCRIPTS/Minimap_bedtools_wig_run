sed 's/+/a/g' rev_seqs_sorted.bed | sed 's/-/b/g' | sed 's/a/-/g'| sed 's/b/+/g' > fwd_rev_seqs_sorted.bed
cat fwd_rev_seqs_sorted.bed fwd_seqs_sorted.bed | bedtools sort -i - | sed -e '/chrMtDNA/d'> fwd_rev_seqs_sorted_combined.bed

bedtools genomecov -i fwd_rev_seqs_sorted_combined.bed -strand + -bg -g Gubbins/Budding_chr_lengthsW303.txt  > fwd_rev_seqs_sorted_combined_plus.bg
bedtools genomecov -i fwd_rev_seqs_sorted_combined.bed -strand - -bg -g Gubbins/Budding_chr_lengthsW303.txt > fwd_rev_seqs_sorted_combined_minus.bg

bedtools map -b fwd_rev_seqs_sorted_combined_plus.bg -a Gubbins/w303_genome_10bp_windows.txt -c 4 -o max -null 0  > fwd_rev_seqs_sorted_combined_plus_10.bg
bedtools map -b fwd_rev_seqs_sorted_combined_minus.bg -a Gubbins/w303_genome_10bp_windows.txt -c 4 -o max -null 0  > fwd_rev_seqs_sorted_combined_minus_10.bg

perl Gubbins/sgr2wig_IW_argv.pl fwd_rev_seqs_sorted_combined_plus_10.bg fwd_rev_seqs_sorted_combined_plus_10
perl Gubbins/sgr2wig_IW_argv.pl fwd_rev_seqs_sorted_combined_minus_10.bg fwd_rev_seqs_sorted_combined_minus_10



